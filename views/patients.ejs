<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Patients' }) %>
</head>
<body>
    <div class="layout">
        <%- include('partials/sidebar') %>

        <div class="main">
            <header class="header">
                <h1 class="header-title">Patients</h1>
            </header>

            <main class="content">
                <div class="page">
                    <div class="toolbar">
                        <p class="hint">
                            Open a chart to see the Blueprint UI embedded in it. Each chart offers
                            three embed styles you can switch between.
                        </p>
                    </div>

                    <div class="table-wrapper">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Patient ID</th>
                                    <th>Age</th>
                                    <th>Diagnosis</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% items.forEach(item => { %>
                                    <tr>
                                        <td>
                                            <a class="table-link" href="/patients/<%= item.id %>"><%= item.name %></a>
                                        </td>
                                        <td class="mono"><%= item.id %></td>
                                        <td><%= item.age %></td>
                                        <td><%= item.diagnosis %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
